# ===== DeepSeek =====
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Supabase =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# PostgREST request timeout in seconds (separate from corpus-download timeout).
SUPABASE_TIMEOUT=60

# ===== Embedding (DashScope TextEmbedding SDK) =====
# Default: Alibaba Cloud DashScope qwen3.7-text-embedding.
EMBEDDING_API_KEY=your_dashscope_api_key
# qwen3.7 supports 1536 dimensions; this keeps the default pgvector schema compatible.
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536
# qwen3.7-text-embedding accepts at most 20 input strings per request.
EMBEDDING_BATCH_SIZE=20

# ===== Web Search (tavily | serper | bing) =====
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your_web_search_api_key

# ===== Agent runtime =====
AGENT_MAX_STEPS=12
AGENT_TOOL_RESULT_MAX_CHARS=6000
AGENT_ANSWER_VERIFICATION_MAX_RETRIES=2
AGENT_JSON_OUTPUT_MAX_TOKENS=4096
RAG_TOP_K=6
RAG_RRF_K=60
WEB_FETCH_TIMEOUT=20
