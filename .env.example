# ===== DeepSeek =====
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Supabase =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===== Embedding (OpenAI-compatible /embeddings endpoint) =====
# Default: Alibaba Cloud DashScope text-embedding-v4 (Qwen3-Embedding series).
# Also works with OpenAI, SiliconFlow, or any OpenAI-compatible /embeddings server.
EMBEDDING_API_KEY=your_dashscope_api_key
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# MUST match the embedding model's real output dimension (Supabase vector(n) must agree).
EMBEDDING_DIMENSIONS=1536

# ===== Web Search (tavily | serper | bing) =====
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your_web_search_api_key

# ===== Agent runtime =====
AGENT_MAX_STEPS=12
AGENT_TOOL_RESULT_MAX_CHARS=6000
RAG_TOP_K=6
RAG_RRF_K=60
WEB_FETCH_TIMEOUT=20
